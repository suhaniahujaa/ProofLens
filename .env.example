# Local mode (default): free Ollama on your own computer.
PROOFLENS_AI_PROVIDER=ollama
PROOFLENS_MODEL=gemma3:4b
PROOFLENS_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_URL=http://127.0.0.1:11434

# Public deployment: set these as HOSTING SECRETS, never commit the real key.
# PROOFLENS_PUBLIC_DEPLOYMENT=1
# PROOFLENS_AI_PROVIDER=groq
# PROOFLENS_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=
